# Copy to .env and fill in. Never commit .env.
# Model: "gemini" (default), "openai" (any OpenAI-compatible server, e.g. vLLM serving Qwen on SCC), or "none".
BIDBRIEF_LLM=gemini
GEMINI_API_KEY=
# An alias that follows Google's latest Flash model. Pin a specific id if you prefer
# (run: python -m bidbrief doctor --ping --list-models).
GEMINI_MODEL=gemini-flash-latest
# Requests per minute. Free tier keys are tight: keep 5 or lower. Paid keys can go to 30+.
LLM_RPM=5

# Local model on SCC (only if BIDBRIEF_LLM=openai)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENAI_API_KEY=not-needed

# Where search models are downloaded (keep it off your small home quota on SCC)
# BIDBRIEF_MODEL_CACHE=/projectnb/<your-project>/<you>/models
# BIDBRIEF_DATA_DIR=/path/to/bidbrief/data
# BIDBRIEF_EMBEDDINGS=1
# BIDBRIEF_RERANK=1

# Trial access codes for uploads (code:packages). Make one with: python -m bidbrief new-code --prefix SEAN
# Leave empty on SCC to allow open uploads; set it before sharing a public link.
BIDBRIEF_TRIAL_CODES=
BIDBRIEF_CONTACT=Ashish Joshi
# Limits for uploaded packages
# BIDBRIEF_MAX_PAGES=600
# BIDBRIEF_MAX_MB=200
